{
  "name": "lightnode",
  "version": "0.1.0",
  "private": true,
  "description": "LightNode - one-flow onboarding for LightChain AI workers. Connect a wallet, check your machine, get a tailored setup, and watch your rewards.",
  "author": "KykyRykyPaloma",
  "license": "MIT",
  "homepage": "https://github.com/marinom2/lightnode",
  "repository": {
    "type": "git",
    "url": "https://github.com/marinom2/lightnode.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prebuild": "npm --prefix sdk install --no-audit --no-fund && npm --prefix sdk run build",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@stackblitz/sdk": "^1.11.1",
    "@tanstack/react-query": "^5.102.8",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lightnode-sdk": "file:./sdk",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.50.4",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.18",
    "husky": "^9.1.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
