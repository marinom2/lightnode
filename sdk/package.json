{
  "name": "lightnode-sdk",
  "version": "0.21.0",
  "description": "Community TypeScript SDK + CLI for LightChain AI: end-to-end encrypted on-chain inference (with optional web search), multi-turn chat, batch + agent runners, read-only network analytics, an Ethereum bridge and LCAI Governor wrapper, and a full worker-operator surface (register, stake, settle, stuck-job recovery, exit). Non-custodial. Built on viem. Independent, not an official LightChain package.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lightnode": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lightchain",
    "lightchain-ai",
    "ai",
    "encrypted-inference",
    "decentralized-ai",
    "inference",
    "worker",
    "web3",
    "evm",
    "viem",
    "cli",
    "sdk"
  ],
  "author": "KykyRykyPaloma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinom2/lightnode.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/marinom2/lightnode/tree/main/sdk#readme",
  "bugs": {
    "url": "https://github.com/marinom2/lightnode/issues"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "viem": "^2"
  },
  "devDependencies": {
    "typescript": "^7",
    "@types/node": "^26"
  },
  "engines": {
    "node": ">=18"
  }
}
